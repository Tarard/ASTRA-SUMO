diff --git a/tests/test_lane_section_hold.py b/tests/test_lane_section_hold.py
index f347ec4..b002a1d 100644
--- a/tests/test_lane_section_hold.py
+++ b/tests/test_lane_section_hold.py
@@ -120,3 +120,48 @@ def test_junction_hold_request_cannot_silently_run_without_a_driver():
 
     with pytest.raises(ValueError, match="Provide lane intentions"):
         monitor_sumo({"all_stopped_timeout_s": 300, "junction_body_hold": True})
+
+
+def test_waypoint_retirement_keeps_the_lane_hold_and_does_not_remove_real_stops():
+    from types import SimpleNamespace
+
+    class WaypointVehicle(Modes):
+        def __init__(self, stop):
+            super().__init__()
+            self.stop = stop
+            self.removed = []
+
+        def getStops(self, identity, limit):
+            assert limit == 1
+            return [self.stop]
+
+        def replaceStop(self, identity, index, edge, *, teleport):
+            self.removed.append((identity, index, edge, teleport))
+
+    def stop(**changes):
+        return SimpleNamespace(**({'lane': 'field_0', 'endPos': 22.4, 'speed': 13.89,
+            'stopFlags': 0, 'stoppingPlaceID': ''} | changes))
+
+    vehicle = WaypointVehicle(stop())
+    driver = LaneSectionHold({'v': ('field_0', 29.9)}, retire_field_waypoint=True)
+    driver.step(vehicle, body_sample('field_0', 2, 100), 0)
+    assert vehicle.removed == [('v', 0, '', 0)] and vehicle.mode == 512
+    driver.step(vehicle, body_sample('field_0', 23, 121), 1)
+    assert len(vehicle.removed) == 1
+    driver.step(vehicle, body_sample(':out_0', 4.91, 132.91), 2)
+    assert vehicle.mode == 1621 and driver.report()['released_vehicles'] == 1
+    assert len(driver.report()['waypoint_retirement']['events']) == 1
+    for changes in ({'speed': 0}, {'lane': 'another_0'}, {'stopFlags': 1}, {'stoppingPlaceID': 'bus'}, {'endPos': 30}):
+        other = WaypointVehicle(stop(**changes))
+        held = LaneSectionHold({'v': ('field_0', 29.9)}, retire_field_waypoint=True)
+        held.step(other, body_sample('field_0', 2, 100), 0)
+        assert not other.removed and other.mode == 512
+
+
+def test_waypoint_retirement_requires_an_explicit_driver():
+    from astra_sumo.core.simulation_stall import monitor_sumo
+
+    with pytest.raises(ValueError, match="Provide lane intentions"):
+        monitor_sumo({'all_stopped_timeout_s': 300, 'retire_field_waypoint': True})
+    with pytest.raises(ValueError, match="true or false"):
+        LaneSectionHold({}, retire_field_waypoint='true')
