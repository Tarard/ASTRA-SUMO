{
  "$defs": {
    "GateStatus": {
      "enum": [
        "not-run",
        "pass",
        "review",
        "fail",
        "blocked"
      ],
      "title": "GateStatus",
      "type": "string"
    },
    "ObservationMatch": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "connection-structural",
            "connection-review",
            "independent-safety",
            "independent-review",
            "exact-delta"
          ],
          "title": "Channel",
          "type": "string"
        },
        "expected_minimum_count": {
          "title": "Expected Minimum Count",
          "type": "integer"
        },
        "matched": {
          "title": "Matched",
          "type": "boolean"
        },
        "observed_count": {
          "title": "Observed Count",
          "type": "integer"
        },
        "schema": {
          "default": "torii.corridor.contracts/v1",
          "title": "Schema",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "value",
        "expected_minimum_count",
        "observed_count",
        "matched"
      ],
      "title": "ObservationMatch",
      "type": "object"
    },
    "SyntheticFaultCaseResult": {
      "additionalProperties": false,
      "properties": {
        "abstention_proven": {
          "title": "Abstention Proven",
          "type": "boolean"
        },
        "blockers": {
          "items": {
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "certification_expectation": {
          "enum": [
            "must-detect",
            "must-abstain"
          ],
          "title": "Certification Expectation",
          "type": "string"
        },
        "connection_status": {
          "title": "Connection Status",
          "type": "string"
        },
        "exact_delta_count": {
          "title": "Exact Delta Count",
          "type": "integer"
        },
        "fault_family": {
          "title": "Fault Family",
          "type": "string"
        },
        "independent_safety_status": {
          "$ref": "#/$defs/GateStatus"
        },
        "mutant_net_path": {
          "title": "Mutant Net Path",
          "type": "string"
        },
        "mutant_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Mutant Sha256",
          "type": "string"
        },
        "observation_matches": {
          "items": {
            "$ref": "#/$defs/ObservationMatch"
          },
          "title": "Observation Matches",
          "type": "array"
        },
        "observed": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object"
          },
          "propertyNames": {
            "enum": [
              "connection-structural",
              "connection-review",
              "independent-safety",
              "independent-review",
              "exact-delta"
            ]
          },
          "title": "Observed",
          "type": "object"
        },
        "schema": {
          "default": "torii.corridor.contracts/v1",
          "title": "Schema",
          "type": "string"
        },
        "source_immutable": {
          "title": "Source Immutable",
          "type": "boolean"
        },
        "source_net_path": {
          "title": "Source Net Path",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GateStatus"
        }
      },
      "required": [
        "case_id",
        "fault_family",
        "certification_expectation",
        "status",
        "source_sha256",
        "mutant_sha256",
        "source_immutable",
        "connection_status",
        "independent_safety_status",
        "exact_delta_count",
        "observation_matches",
        "observed",
        "abstention_proven",
        "blockers",
        "source_net_path",
        "mutant_net_path"
      ],
      "title": "SyntheticFaultCaseResult",
      "type": "object"
    }
  },
  "$id": "https://github.com/Tarard/Torii-SUMO/schemas/torii.corridor.synthetic-fault-benchmark-report.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "benchmark_id": {
      "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
      "title": "Benchmark Id",
      "type": "string"
    },
    "benchmark_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Benchmark Spec Sha256",
      "type": "string"
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/SyntheticFaultCaseResult"
      },
      "title": "Cases",
      "type": "array"
    },
    "clean_fixture_statuses": {
      "additionalProperties": {
        "$ref": "#/$defs/GateStatus"
      },
      "title": "Clean Fixture Statuses",
      "type": "object"
    },
    "failed_case_count": {
      "title": "Failed Case Count",
      "type": "integer"
    },
    "must_abstain_case_count": {
      "title": "Must Abstain Case Count",
      "type": "integer"
    },
    "must_abstain_passed_count": {
      "title": "Must Abstain Passed Count",
      "type": "integer"
    },
    "must_detect_case_count": {
      "title": "Must Detect Case Count",
      "type": "integer"
    },
    "must_detect_passed_count": {
      "title": "Must Detect Passed Count",
      "type": "integer"
    },
    "passed_case_count": {
      "title": "Passed Case Count",
      "type": "integer"
    },
    "schema": {
      "default": "torii.corridor.synthetic-fault-benchmark-report/v1",
      "title": "Schema",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/GateStatus"
    },
    "total_case_count": {
      "title": "Total Case Count",
      "type": "integer"
    }
  },
  "required": [
    "benchmark_id",
    "benchmark_spec_sha256",
    "status",
    "total_case_count",
    "passed_case_count",
    "failed_case_count",
    "must_detect_case_count",
    "must_detect_passed_count",
    "must_abstain_case_count",
    "must_abstain_passed_count",
    "clean_fixture_statuses",
    "cases",
    "blockers"
  ],
  "title": "SyntheticFaultBenchmarkReport",
  "type": "object",
  "x-torii-status": "stage-1-evidence-contract"
}