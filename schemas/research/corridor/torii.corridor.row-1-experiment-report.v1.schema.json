{
  "$defs": {
    "GateStatus": {
      "enum": [
        "not-run",
        "pass",
        "review",
        "fail",
        "blocked"
      ],
      "title": "GateStatus",
      "type": "string"
    },
    "ROWExperimentCaseResult": {
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "items": {
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        },
        "case_id": {
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
          "title": "Case Id",
          "type": "string"
        },
        "case_key": {
          "title": "Case Key",
          "type": "string"
        },
        "case_kind": {
          "enum": [
            "gold",
            "mutation",
            "ood"
          ],
          "title": "Case Kind",
          "type": "string"
        },
        "case_passed": {
          "title": "Case Passed",
          "type": "boolean"
        },
        "expected_model_claim_class": {
          "enum": [
            "signalized",
            "priority-unsignalized",
            "unprioritized-unsignalized",
            "ambiguous",
            "unmapped"
          ],
          "title": "Expected Model Claim Class",
          "type": "string"
        },
        "expected_simultaneous_behavior": {
          "anyOf": [
            {
              "enum": [
                "vehicle-yielded",
                "pedestrian-yielded",
                "no-interaction",
                "unsafe-overlap",
                "unresolved"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Simultaneous Behavior"
        },
        "expected_source_class": {
          "enum": [
            "signalized",
            "priority-unsignalized",
            "unprioritized-unsignalized",
            "unknown-unsignalized",
            "shared-space-or-unsupported"
          ],
          "title": "Expected Source Class",
          "type": "string"
        },
        "expected_static_status": {
          "$ref": "#/$defs/GateStatus"
        },
        "geometry_evidence": {
          "$ref": "#/$defs/ROWGeometryEvidence"
        },
        "model_claim": {
          "$ref": "#/$defs/ROWModelClaimEvidence"
        },
        "mutation_kind": {
          "enum": [
            "none",
            "request-response-priority-reversed",
            "source-priority-reversed",
            "co-self-consistent-model-reversal",
            "internal-waiting-removed",
            "signal-state-g-g-reversed",
            "not-applicable"
          ],
          "title": "Mutation Kind",
          "type": "string"
        },
        "runtime_probes": {
          "items": {
            "$ref": "#/$defs/ROWRuntimeProbe"
          },
          "title": "Runtime Probes",
          "type": "array"
        },
        "schema": {
          "default": "torii.corridor.row-experiment-case/v1",
          "title": "Schema",
          "type": "string"
        },
        "source_bundle": {
          "$ref": "#/$defs/SourceROWBundle"
        },
        "source_decision": {
          "$ref": "#/$defs/SourceROWOracleDecision"
        },
        "static_assessment": {
          "$ref": "#/$defs/ROWStaticAssessment"
        },
        "vehicle_turn_class": {
          "enum": [
            "straight",
            "left",
            "right",
            "not-applicable"
          ],
          "title": "Vehicle Turn Class",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_key",
        "case_kind",
        "mutation_kind",
        "vehicle_turn_class",
        "source_bundle",
        "source_decision",
        "geometry_evidence",
        "model_claim",
        "static_assessment",
        "runtime_probes",
        "expected_source_class",
        "expected_model_claim_class",
        "expected_static_status",
        "expected_simultaneous_behavior",
        "blockers",
        "case_passed"
      ],
      "title": "ROWExperimentCaseResult",
      "type": "object"
    },
    "ROWGeometryEvidence": {
      "additionalProperties": false,
      "properties": {
        "candidate_net_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Net Sha256",
          "type": "string"
        },
        "centerline_intersects": {
          "title": "Centerline Intersects",
          "type": "boolean"
        },
        "crossing_angle_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Crossing Angle Deg"
        },
        "crossing_edge_id": {
          "title": "Crossing Edge Id",
          "type": "string"
        },
        "geometry_evidence_id": {
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
          "title": "Geometry Evidence Id",
          "type": "string"
        },
        "minimum_centerline_distance_m": {
          "minimum": 0.0,
          "title": "Minimum Centerline Distance M",
          "type": "number"
        },
        "request_foes_fields_read": {
          "default": [],
          "maxItems": 0,
          "minItems": 0,
          "title": "Request Foes Fields Read",
          "type": "array"
        },
        "right_of_way_inference": {
          "const": "not-inferred",
          "default": "not-inferred",
          "title": "Right Of Way Inference",
          "type": "string"
        },
        "schema": {
          "default": "torii.corridor.row-geometry-evidence/v1",
          "title": "Schema",
          "type": "string"
        },
        "vehicle_from_edge_id": {
          "title": "Vehicle From Edge Id",
          "type": "string"
        },
        "vehicle_to_edge_id": {
          "title": "Vehicle To Edge Id",
          "type": "string"
        }
      },
      "required": [
        "geometry_evidence_id",
        "candidate_net_sha256",
        "crossing_edge_id",
        "vehicle_from_edge_id",
        "vehicle_to_edge_id",
        "centerline_intersects",
        "minimum_centerline_distance_m",
        "crossing_angle_deg"
      ],
      "title": "ROWGeometryEvidence",
      "type": "object"
    },
    "ROWModelClaimEvidence": {
      "additionalProperties": false,
      "properties": {
        "bit_order": {
          "const": "rightmost-bit-is-index-zero",
          "default": "rightmost-bit-is-index-zero",
          "title": "Bit Order",
          "type": "string"
        },
        "candidate_net_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Net Sha256",
          "type": "string"
        },
        "controller_ids": {
          "items": {
            "type": "string"
          },
          "title": "Controller Ids",
          "type": "array"
        },
        "crossing_edge_id": {
          "title": "Crossing Edge Id",
          "type": "string"
        },
        "ground_truth_authority": {
          "const": false,
          "default": false,
          "title": "Ground Truth Authority",
          "type": "boolean"
        },
        "inferred_class": {
          "enum": [
            "signalized",
            "priority-unsignalized",
            "unprioritized-unsignalized",
            "ambiguous",
            "unmapped"
          ],
          "title": "Inferred Class",
          "type": "string"
        },
        "junction_id": {
          "title": "Junction Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "model_claim_id": {
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
          "title": "Model Claim Id",
          "type": "string"
        },
        "relation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ROWRequestRelation"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema": {
          "default": "torii.corridor.row-model-claim-evidence/v1",
          "title": "Schema",
          "type": "string"
        },
        "source_connection_states": {
          "items": {
            "type": "string"
          },
          "title": "Source Connection States",
          "type": "array"
        },
        "vehicle_from_edge_id": {
          "title": "Vehicle From Edge Id",
          "type": "string"
        },
        "vehicle_to_edge_id": {
          "title": "Vehicle To Edge Id",
          "type": "string"
        }
      },
      "required": [
        "model_claim_id",
        "candidate_net_sha256",
        "junction_id",
        "crossing_edge_id",
        "vehicle_from_edge_id",
        "vehicle_to_edge_id",
        "inferred_class",
        "relation",
        "controller_ids",
        "source_connection_states",
        "limitations"
      ],
      "title": "ROWModelClaimEvidence",
      "type": "object"
    },
    "ROWRequestRelation": {
      "additionalProperties": false,
      "properties": {
        "pedestrian_cont": {
          "title": "Pedestrian Cont",
          "type": "boolean"
        },
        "pedestrian_foe_to_vehicle": {
          "title": "Pedestrian Foe To Vehicle",
          "type": "boolean"
        },
        "pedestrian_request_index": {
          "minimum": 0,
          "title": "Pedestrian Request Index",
          "type": "integer"
        },
        "pedestrian_response_to_vehicle": {
          "title": "Pedestrian Response To Vehicle",
          "type": "boolean"
        },
        "schema": {
          "default": "torii.corridor.contracts/v1",
          "title": "Schema",
          "type": "string"
        },
        "vehicle_cont": {
          "title": "Vehicle Cont",
          "type": "boolean"
        },
        "vehicle_foe_to_pedestrian": {
          "title": "Vehicle Foe To Pedestrian",
          "type": "boolean"
        },
        "vehicle_request_index": {
          "minimum": 0,
          "title": "Vehicle Request Index",
          "type": "integer"
        },
        "vehicle_response_to_pedestrian": {
          "title": "Vehicle Response To Pedestrian",
          "type": "boolean"
        }
      },
      "required": [
        "pedestrian_request_index",
        "vehicle_request_index",
        "pedestrian_response_to_vehicle",
        "vehicle_response_to_pedestrian",
        "pedestrian_foe_to_vehicle",
        "vehicle_foe_to_pedestrian",
        "pedestrian_cont",
        "vehicle_cont"
      ],
      "title": "ROWRequestRelation",
      "type": "object"
    },
    "ROWRuntimeProbe": {
      "additionalProperties": false,
      "properties": {
        "arrival_schedule": {
          "enum": [
            "pedestrian-first",
            "vehicle-first",
            "simultaneous"
