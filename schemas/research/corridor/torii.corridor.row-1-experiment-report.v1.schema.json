        },
        "pedestrian_crossing_exit_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pedestrian Crossing Exit S"
        },
        "pedestrian_depart_s": {
          "minimum": 0.0,
          "title": "Pedestrian Depart S",
          "type": "number"
        },
        "pedestrian_stopped_before_crossing_s": {
          "minimum": 0.0,
          "title": "Pedestrian Stopped Before Crossing S",
          "type": "number"
        },
        "pedestrian_wait_window_s": {
          "exclusiveMinimum": 0.0,
          "title": "Pedestrian Wait Window S",
          "type": "number"
        },
        "proves_real_world_priority": {
          "const": false,
          "default": false,
          "title": "Proves Real World Priority",
          "type": "boolean"
        },
        "random_seed": {
          "minimum": 0,
          "title": "Random Seed",
          "type": "integer"
        },
        "route_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Route Sha256",
          "type": "string"
        },
        "runtime_probe_id": {
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
          "title": "Runtime Probe Id",
          "type": "string"
        },
        "runtime_status": {
          "$ref": "#/$defs/GateStatus"
