          "type": "string"
        },
        "collision_count": {
          "minimum": 0,
          "title": "Collision Count",
          "type": "integer"
        },
        "completed": {
          "title": "Completed",
          "type": "boolean"
        },
        "crossing_edge_id": {
          "title": "Crossing Edge Id",
          "type": "string"
        },
        "emergency_braking_count": {
          "minimum": 0,
          "title": "Emergency Braking Count",
          "type": "integer"
        },
        "observed_behavior": {
          "enum": [
