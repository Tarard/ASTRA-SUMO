        "schema": {
          "default": "torii.corridor.row-runtime-probe/v1",
          "title": "Schema",
          "type": "string"
        },
        "simulation_end_s": {
          "exclusiveMinimum": 0.0,
          "title": "Simulation End S",
          "type": "number"
        },
        "simulation_step_s": {
          "exclusiveMinimum": 0.0,
          "title": "Simulation Step S",
          "type": "number"
        },
        "stop_speed_threshold_mps": {
          "minimum": 0.0,
          "title": "Stop Speed Threshold Mps",
          "type": "number"
        },
        "sumo_binary_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sumo Binary Sha256",
          "type": "string"
        },
        "sumo_version": {
          "title": "Sumo Version",
          "type": "string"
        },
        "vehicle_depart_s": {
          "minimum": 0.0,
          "title": "Vehicle Depart S",
          "type": "number"
        },
        "vehicle_internal_entry_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Vehicle Internal Entry S"
        },
        "vehicle_internal_exit_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Vehicle Internal Exit S"
        },
        "vehicle_internal_lane_id": {
          "title": "Vehicle Internal Lane Id",
          "type": "string"
        },
        "vehicle_speed_mps": {
          "exclusiveMinimum": 0.0,
          "title": "Vehicle Speed Mps",
          "type": "number"
        },
        "vehicle_stopped_before_conflict_s": {
          "minimum": 0.0,
          "title": "Vehicle Stopped Before Conflict S",
          "type": "number"
        },
        "yield_stop_threshold_s": {
          "exclusiveMinimum": 0.0,
          "title": "Yield Stop Threshold S",
          "type": "number"
        }
      },
      "required": [
        "runtime_probe_id",
        "candidate_net_sha256",
        "route_sha256",
        "sumo_binary_sha256",
        "sumo_version",
        "crossing_edge_id",
        "vehicle_internal_lane_id",
        "arrival_schedule",
        "pedestrian_depart_s",
        "vehicle_depart_s",
        "vehicle_speed_mps",
        "simulation_step_s",
        "simulation_end_s",
        "random_seed",
        "stop_speed_threshold_mps",
        "yield_stop_threshold_s",
        "pedestrian_wait_window_s",
        "pedestrian_crossing_entry_s",
        "pedestrian_crossing_exit_s",
        "vehicle_internal_entry_s",
        "vehicle_internal_exit_s",
        "vehicle_stopped_before_conflict_s",
