{
  "$defs": {
    "GateStatus": {
      "enum": [
        "not-run",
        "pass",
        "review",
        "fail",
        "blocked"
      ],
      "title": "GateStatus",
      "type": "string"
    },
    "OODBenchmarkCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "expected_decision": {
          "enum": [
            "in-domain",
            "out-of-domain"
          ],
          "title": "Expected Decision",
          "type": "string"
        },
        "expected_independent_safety_status": {
          "$ref": "#/$defs/GateStatus"
        },
        "expected_reason_categories": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Expected Reason Categories",
          "type": "array"
        },
        "fixture_id": {
          "title": "Fixture Id",
          "type": "string"
        },
        "mutation_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Mutation Ids",
          "type": "array"
        },
        "schema": {
          "default": "torii.corridor.contracts/v1",
          "title": "Schema",
          "type": "string"
        },
        "traffic_side": {
          "$ref": "#/$defs/TrafficSide"
        }
      },
      "required": [
        "case_id",
        "fixture_id",
        "traffic_side",
        "expected_decision",
        "expected_independent_safety_status"
      ],
      "title": "OODBenchmarkCase",
      "type": "object"
    },
    "TrafficSide": {
      "enum": [
        "right",
        "left",
        "unknown"
      ],
      "title": "TrafficSide",
      "type": "string"
    }
  },
  "$id": "https://github.com/Tarard/Torii-SUMO/schemas/torii.corridor.ood-benchmark.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "benchmark_id": {
      "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
      "title": "Benchmark Id",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/OODBenchmarkCase"
      },
      "title": "Cases",
      "type": "array"
    },
    "certification_envelope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Certification Envelope Sha256",
      "type": "string"
    },
    "parent_benchmark_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Parent Benchmark Sha256",
      "type": "string"
    },
    "schema": {
      "default": "torii.corridor.ood-benchmark/v1",
      "title": "Schema",
      "type": "string"
    }
  },
  "required": [
    "benchmark_id",
    "parent_benchmark_sha256",
    "certification_envelope_sha256",
    "cases"
  ],
  "title": "OODBenchmarkSpec",
  "type": "object",
  "x-torii-status": "stage-1-ood-contract"
}