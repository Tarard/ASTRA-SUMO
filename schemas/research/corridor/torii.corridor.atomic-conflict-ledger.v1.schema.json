{
  "$defs": {
    "AtomicConflictWitness": {
      "additionalProperties": false,
      "properties": {
        "atomic_witness_id": {
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
          "title": "Atomic Witness Id",
          "type": "string"
        },
        "candidate_net_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Net Sha256",
          "type": "string"
        },
        "certainty": {
          "enum": [
            "confirmed",
            "potential"
          ],
          "title": "Certainty",
          "type": "string"
        },
        "conflict_reason": {
          "title": "Conflict Reason",
          "type": "string"
        },
        "conflicting_approach_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
            "type": "string"
          },
          "title": "Conflicting Approach Ids",
          "type": "array"
        },
        "conflicting_lane_roles": {
          "items": {
            "type": "string"
          },
          "title": "Conflicting Lane Roles",
          "type": "array"
        },
        "conflicting_mode_classes": {
          "items": {
            "type": "string"
          },
          "title": "Conflicting Mode Classes",
          "type": "array"
        },
        "conflicting_movement_id": {
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
          "title": "Conflicting Movement Id",
          "type": "string"
        },
        "conflicting_physical_cell_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
            "type": "string"
          },
          "title": "Conflicting Physical Cell Ids",
          "type": "array"
        },
        "conflicting_source_lane_role_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
            "type": "string"
          },
          "title": "Conflicting Source Lane Role Ids",
          "type": "array"
        },
        "conflicting_speed_mps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Conflicting Speed Mps"
        },
        "conflicting_turn_classes": {
          "items": {
            "type": "string"
          },
          "title": "Conflicting Turn Classes",
          "type": "array"
        },
        "control_class": {
          "title": "Control Class",
          "type": "string"
        },
        "crossing_angle_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Crossing Angle Deg"
        },
        "crossing_morphology": {
          "title": "Crossing Morphology",
          "type": "string"
        },
        "crossing_signature": {
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
          "title": "Crossing Signature",
          "type": "string"
        },
        "envelope_margin_m": {
          "minimum": 0.0,
          "title": "Envelope Margin M",
          "type": "number"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "grade_evidence_signature": {
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
          "title": "Grade Evidence Signature",
          "type": "string"
        },
        "grade_relation": {
          "title": "Grade Relation",
          "type": "string"
        },
        "hard_safety_finding": {
          "title": "Hard Safety Finding",
          "type": "boolean"
        },
        "minimum_centerline_distance_m": {
          "minimum": 0.0,
          "title": "Minimum Centerline Distance M",
          "type": "number"
        },
        "pedestrian_movement_id": {
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
          "title": "Pedestrian Movement Id",
          "type": "string"
        },
        "pedestrian_physical_cell_id": {
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
          "title": "Pedestrian Physical Cell Id",
          "type": "string"
        },
        "request_foes_mapping_status": {
          "enum": [
            "mapped",
            "unmapped",
            "not-applicable"
          ],
          "title": "Request Foes Mapping Status",
          "type": "string"
        },
        "request_foes_relation": {
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
          "title": "Request Foes Relation",
          "type": "string"
        },
        "right_of_way_evidence_class": {
          "enum": [
            "source-priority",
            "source-unprioritized",
            "unknown",
            "unsupported"
          ],
          "title": "Right Of Way Evidence Class",
          "type": "string"
        },
        "road_classes": {
          "items": {
            "type": "string"
          },
          "title": "Road Classes",
          "type": "array"
        },
        "schema": {
          "default": "torii.corridor.atomic-conflict-witness/v1",
          "title": "Schema",
          "type": "string"
        },
        "source_osm_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Osm Sha256",
          "type": "string"
        },
        "speed_band": {
          "title": "Speed Band",
          "type": "string"
        },
        "toolchain_id": {
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
          "title": "Toolchain Id",
          "type": "string"
        },
        "traffic_side": {
          "$ref": "#/$defs/TrafficSide"
        },
        "witness_signature": {
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
          "title": "Witness Signature",
          "type": "string"
        }
      },
      "required": [
        "atomic_witness_id",
        "witness_signature",
        "pedestrian_movement_id",
        "conflicting_movement_id",
        "pedestrian_physical_cell_id",
        "conflicting_physical_cell_ids",
        "crossing_signature",
        "conflict_reason",
        "certainty",
        "minimum_centerline_distance_m",
        "crossing_angle_deg",
        "envelope_margin_m",
        "conflicting_approach_ids",
        "conflicting_source_lane_role_ids",
        "conflicting_lane_roles",
        "conflicting_turn_classes",
        "conflicting_mode_classes",
        "conflicting_speed_mps",
        "road_classes",
        "speed_band",
        "control_class",
        "right_of_way_evidence_class",
        "request_foes_relation",
        "request_foes_mapping_status",
        "traffic_side",
        "crossing_morphology",
        "grade_relation",
        "grade_evidence_signature",
        "hard_safety_finding",
        "source_osm_sha256",
        "candidate_net_sha256",
        "toolchain_id",
        "evidence_refs"
      ],
      "title": "AtomicConflictWitness",
      "type": "object"
    },
    "GateStatus": {
      "enum": [
        "not-run",
        "pass",
        "review",
        "fail",
        "blocked"
      ],
      "title": "GateStatus",
      "type": "string"
    },
    "TrafficSide": {
      "enum": [
        "right",
        "left",
        "unknown"
      ],
      "title": "TrafficSide",
      "type": "string"
    }
  },
  "$id": "https://github.com/Tarard/Torii-SUMO/schemas/torii.corridor.atomic-conflict-ledger.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "automatic_promotion_gate": {
      "$ref": "#/$defs/GateStatus",
      "default": "blocked"
    },
    "candidate_net_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Net Sha256",
      "type": "string"
    },
    "confirmed_count": {
      "minimum": 0,
      "title": "Confirmed Count",
      "type": "integer"
    },
    "coverage_gate": {
      "$ref": "#/$defs/GateStatus"
    },
    "ledger_id": {
      "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
      "title": "Ledger Id",
      "type": "string"
    },
    "potential_count": {
      "minimum": 0,
      "title": "Potential Count",
      "type": "integer"
    },
    "schema": {
      "default": "torii.corridor.atomic-conflict-ledger/v1",
      "title": "Schema",
      "type": "string"
    },
    "source_finding_count": {
      "minimum": 0,
      "title": "Source Finding Count",
      "type": "integer"
    },
    "source_osm_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Osm Sha256",
      "type": "string"
    },
    "toolchain_id": {
      "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
      "title": "Toolchain Id",
      "type": "string"
    },
    "witness_count": {
      "minimum": 0,
      "title": "Witness Count",
      "type": "integer"
    },
    "witness_set_signature": {
      "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
      "title": "Witness Set Signature",
      "type": "string"
    },
    "witnesses": {
      "items": {
        "$ref": "#/$defs/AtomicConflictWitness"
      },
      "title": "Witnesses",
      "type": "array"
    }
  },
  "required": [
    "ledger_id",
    "source_osm_sha256",
    "candidate_net_sha256",
    "toolchain_id",
    "witness_count",
    "confirmed_count",
    "potential_count",
    "source_finding_count",
    "witness_set_signature",
    "witnesses",
    "coverage_gate"
  ],
  "title": "AtomicConflictLedger",
  "type": "object",
  "x-torii-status": "stage-1m-rwc-1-lossless-atomic-witness-contract"
}