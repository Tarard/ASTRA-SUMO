    "AtomicConflictLedger": {
      "additionalProperties": false,
      "properties": {
        "automatic_promotion_gate": {
          "$ref": "#/$defs/GateStatus",
          "default": "blocked"
        },
        "candidate_net_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Net Sha256",
          "type": "string"
        },
        "confirmed_count": {
          "minimum": 0,
          "title": "Confirmed Count",
          "type": "integer"
        },
        "coverage_gate": {
          "$ref": "#/$defs/GateStatus"
        },
        "ledger_id": {
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
          "title": "Ledger Id",
          "type": "string"
        },
        "potential_count": {
          "minimum": 0,
          "title": "Potential Count",
          "type": "integer"
        },
        "schema": {
          "default": "torii.corridor.atomic-conflict-ledger/v1",
          "title": "Schema",
          "type": "string"
        },
        "source_finding_count": {
          "minimum": 0,
          "title": "Source Finding Count",
          "type": "integer"
        },
        "source_osm_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Osm Sha256",
          "type": "string"
        },
        "toolchain_id": {
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
          "title": "Toolchain Id",
          "type": "string"
        },
        "witness_count": {
          "minimum": 0,
          "title": "Witness Count",
          "type": "integer"
        },
        "witness_set_signature": {
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{24}$",
          "title": "Witness Set Signature",
          "type": "string"
        },
        "witnesses": {
          "items": {
            "$ref": "#/$defs/AtomicConflictWitness"
          },
          "title": "Witnesses",
          "type": "array"
        }
      },
      "required": [
        "ledger_id",
        "source_osm_sha256",
        "candidate_net_sha256",
        "toolchain_id",
        "witness_count",
        "confirmed_count",
        "potential_count",
        "source_finding_count",
        "witness_set_signature",
        "witnesses",
        "coverage_gate"
      ],
      "title": "AtomicConflictLedger",
      "type": "object"
    },
