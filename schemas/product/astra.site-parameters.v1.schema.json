{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astra.site-parameters.v1.schema.json",
  "title": "Legacy site parameters with explicit field-acceptance limits",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "field_acceptance",
    "source_module_sha256_before_extraction",
    "parameters"
  ],
  "properties": {
    "schema": {
      "const": "astra.site-parameters/v1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "field_acceptance": {
      "const": "legacy_snapshot_only_requires_source_match"
    },
    "source_module_sha256_before_extraction": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parameters": {
      "type": "object",
      "minProperties": 1
    }
  }
}
